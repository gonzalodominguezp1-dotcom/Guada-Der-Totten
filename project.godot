; Engine configuration file.
; Zombies del Pueblo - Guadalix de la Sierra

config_version=5

[application]

config/name="Zombies del Pueblo"
config/description="Zombies al estilo World at War en Guadalix de la Sierra"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
limits/opengl/max_lights_per_object=16
limits/opengl/max_renderable_lights=64
